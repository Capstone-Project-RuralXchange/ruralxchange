PORT=5000
MONGODB_URI=mongodb://localhost:27017/ruralxchange
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NODE_ENV=development
# Exact frontend origin, required for cookie sessions and CSRF checks.
CLIENT_URL=http://localhost:3000
# Render is one trusted reverse proxy. Adjust to your actual hosting topology.
TRUST_PROXY_HOPS=1
# Booking transactions REQUIRE a replica set (Atlas supports this).
# Local example: mongodb://localhost:27017/ruralxchange?replicaSet=rs0
